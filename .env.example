# ──────────────────────────────────────────────────────────────────────────────
# Minha Tize — Variáveis de ambiente para Vercel
# Copie este arquivo como .env.local para desenvolvimento local
# No Vercel: Settings → Environment Variables → adicione cada uma abaixo
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (banco de tokens) ─────────────────────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (envio de e-mail) ───────────────────────────────────────────────────
# Encontre em: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── E-mail de envio (deve estar verificado no Resend) ────────────────────────
EMAIL_FROM=Minha Tize <noreply@seudominio.com.br>

# ── URL pública do app (sem barra no final) ───────────────────────────────────
APP_URL=https://minhatize.vercel.app

# ── URL do PDF do protocolo (Google Drive, S3, Vercel Blob, etc.) ─────────────
# Deixe vazio para não incluir o PDF no e-mail de boas-vindas
PDF_URL=https://drive.google.com/file/d/SEU_ID_AQUI/view

# ── Segredo do webhook da Kiwify ──────────────────────────────────────────────
# Defina uma string aleatória forte (ex: openssl rand -base64 32)
# Configure o mesmo valor no painel da Kiwify → Webhooks → Secret
KIWIFY_WEBHOOK_SECRET=sua_chave_secreta_aqui
