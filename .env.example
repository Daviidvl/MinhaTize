# ──────────────────────────────────────────────────────────────────────────────
# MinhaTize — variáveis de ambiente (todas usadas só no servidor, em api/)
#
# Local:  copie para .env.local e preencha (nunca commite .env.local)
# Vercel: Settings → Environment Variables → cadastre cada uma
#
# Nenhuma variável deve receber o prefixo VITE_: isso a colocaria no bundle
# público do navegador.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (tabelas tokens e consents) ──────────────────────────────────────
# supabase.com → projeto → Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role: ignora o RLS. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# ── Wiven (webhook de pagamento) ──────────────────────────────────────────────
# Mesmo valor configurado no painel da Wiven → Webhooks → Token
WIVEN_WEBHOOK_SECRET=uma_string_aleatoria_longa
# Eventos que revogam o acesso (reembolso, chargeback), separados por vírgula.
# Use os nomes exatos que a Wiven envia — eles aparecem no log da função como
# "[webhook] Evento ignorado: <NOME>". Vazio = nenhum evento revoga.
WIVEN_REVOKE_EVENTS=

# ── Resend (e-mail com o token) ───────────────────────────────────────────────
RESEND_API_KEY=sua_chave_resend
# Precisa ser de um domínio verificado no Resend
EMAIL_FROM=noreply@seudominio.com.br

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL pública do app, sem barra no final
APP_URL=https://minhatize.vercel.app
# Opcional. Padrão: APP_URL/guia-instalacao.pdf
PDF_URL=

# ── Anthropic (relatório anti-platô) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sua_chave_anthropic
# Opcional. Padrão: claude-haiku-5-5. Troque aqui quando o modelo for aposentado.
ANTHROPIC_MODEL=

# ── Upstash Redis (rate limit distribuído) ────────────────────────────────────
# console.upstash.com → Redis → REST API
# Sem estas duas, o limite de requisições fica em memória por instância
# serverless e não vale entre instâncias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Notificações push (lembretes com o app fechado) ───────────────────────────
# Gere uma vez com:  npx web-push generate-vapid-keys
# Trocar as chaves depois invalida a inscrição de todos os aparelhos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente para os serviços de push (mailto: ou https:). Padrão: APP_URL
VAPID_SUBJECT=
# Segredo que o agendador envia em "Authorization: Bearer ..." ao chamar
# /api/push-cron. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Prova de acesso offline (api/_lib/accessProof.ts) ─────────────────────────
# Chave privada ECDSA P-256 (PKCS8 DER em base64). A pública correspondente fica
# em src/utils/accessProof.ts. Sem esta variável o app só abre com internet.
# Gerar um novo par (troca as duas de uma vez):
#   node -e "const {generateKeyPairSync:g}=require('crypto');const {privateKey:k,publicKey:p}=g('ec',{namedCurve:'P-256'});console.log('PRIVADA',k.export({format:'der',type:'pkcs8'}).toString('base64'));console.log('PUBLICA',p.export({format:'der',type:'spki'}).toString('base64'))"
ACCESS_PROOF_PRIVATE_KEY=
