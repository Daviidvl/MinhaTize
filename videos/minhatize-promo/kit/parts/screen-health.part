<div class="mt-app">
  <div class="mt-app-pad">
    <div class="mt-a-hdr">
      <div><div class="mt-a-title">Saúde</div><div class="mt-a-sub">Seu cuidado completo</div></div>
      <div class="mt-a-ico">{{icon:heart}}</div>
    </div>

    <div class="mt-a-card mt-h-water" style="display:flex;align-items:center;gap:14px;padding:16px;background:linear-gradient(135deg,#A3C9F2 0%,#94DCD3 100%);border:none">
      <div style="position:relative;width:76px;height:76px;flex-shrink:0">
        <svg width="76" height="76" viewBox="0 0 76 76"><circle cx="38" cy="38" r="31" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="7"/><circle cx="38" cy="38" r="31" fill="none" stroke="#0B2545" stroke-width="7" stroke-linecap="round" stroke-dasharray="194.78" stroke-dashoffset="74" transform="rotate(-90 38 38)"/></svg>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800">62%</div>
      </div>
      <div><div style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0B2545">Hidratação</div><div class="mt-a-num" style="font-size:30px;margin-top:4px">1,8 <span style="font-size:14px;font-weight:600;letter-spacing:0">de 2,9 L</span></div></div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px">
      {{htile:activity:Sintomas:Leves hoje}}
      {{htile:flask:Laboratório:12 exames}}
      {{htile:dumbbell:Exercícios:3x na semana}}
      {{htile:utensils:Alimentação:Plano proteico}}
      {{htile:trend:Anti-platô:Sem platô}}
      {{htile:calendar:Aplicações:Em dia}}
    </div>
  </div>
  {{nav:2}}
</div>
