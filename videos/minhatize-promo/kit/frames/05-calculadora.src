---
id: 05-calculadora
prefix: f05
duration: 5.47
title: Dose exata
transition: push-slide LEFT
---
<!--CSS-->
.mt-copy { position:absolute; left:96px; right:96px; top:200px; }
.mt-copy .mt-eyebrow { margin-bottom:22px; }
.mt-copy .mt-h .mt-line { display:block; }
.mt-copy .mt-fine { margin-top:22px; display:flex; align-items:center; gap:12px; }
.mt-copy .mt-fine i { display:block; width:10px; height:10px; border-radius:50%; background:#E08A12; }
/* big syringe, needle down */
.mt-syr { position:absolute; left:812px; top:600px; width:160px; height:960px; }
.mt-syr .mt-rod { position:absolute; left:72px; width:16px; top:71px; height:630px; border-radius:6px; background:linear-gradient(90deg,#8FBDF0,#DCE9F9 50%,#8FBDF0); }
.mt-syr .mt-thumb { position:absolute; left:26px; width:108px; height:22px; top:49px; border-radius:11px; background:linear-gradient(180deg,#DCE9F9,#8FBDF0); box-shadow:0 8px 20px rgba(0,0,0,.4); }
.mt-syr .mt-flange { position:absolute; left:0; width:160px; height:16px; top:180px; border-radius:8px; background:rgba(220,233,249,0.85); }
.mt-syr .mt-barrel { position:absolute; left:34px; width:92px; top:196px; height:640px; border-radius:18px; overflow:hidden;
  background:linear-gradient(90deg, rgba(220,233,249,0.10), rgba(220,233,249,0.28) 30%, rgba(220,233,249,0.06) 70%, rgba(220,233,249,0.18));
  border:2px solid rgba(220,233,249,0.55); }
.mt-syr .mt-liquid { position:absolute; left:0; right:0; bottom:0; height:17%; transform-origin:50% 100%; background:linear-gradient(180deg,#3A86E0 0%,#19B5A5 100%); box-shadow:0 0 30px rgba(43,212,192,0.5); }
.mt-syr .mt-stopper { position:absolute; left:2px; right:2px; height:26px; bottom:17%; border-radius:6px; background:linear-gradient(180deg,#0B2545,#162558); }
.mt-syr .mt-ticks { position:absolute; inset:0; background:repeating-linear-gradient(180deg, rgba(244,248,254,0.55) 0 2px, transparent 2px 6.4px); -webkit-mask:linear-gradient(90deg,#000 0 22%,transparent 22%); mask:linear-gradient(90deg,#000 0 22%,transparent 22%); }
.mt-syr .mt-ticks10 { position:absolute; inset:0; background:repeating-linear-gradient(180deg, rgba(244,248,254,0.9) 0 3px, transparent 3px 64px); -webkit-mask:linear-gradient(90deg,#000 0 40%,transparent 40%); mask:linear-gradient(90deg,#000 0 40%,transparent 40%); }
.mt-syr .mt-hub { position:absolute; left:58px; width:44px; top:836px; height:34px; border-radius:0 0 10px 10px; background:rgba(220,233,249,0.8); }
.mt-syr .mt-needle { position:absolute; left:78px; width:4px; top:870px; height:90px; background:linear-gradient(180deg,#DCE9F9,#8FBDF0); border-radius:0 0 2px 2px; }
.mt-syr .mt-mark { position:absolute; right:-8px; width:24px; height:3px; background:#2BD4C0; box-shadow:0 0 12px #2BD4C0; }
.mt-ui { left:560px; top:1440px; }
.mt-ui .mt-gt { font-size:46px; }
<!--SKETCHCSS-->
.sk .mt-phone { transform:rotateY(12deg) rotateX(3deg); }
<!--HTML-->
{{stagebg}}
<div class="mt-rings" style="top:1050px;left:420px"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div></div>
{{dust:40:55}}
<div class="mt-copy">
  <div class="mt-eyebrow mt-e">Calculadora</div>
  <div class="mt-h"><span class="mt-line mt-l1">Da dose em mg</span><span class="mt-line mt-l2"><b>para unidades.</b></span></div>
  <div class="mt-fine mt-warn"><i></i>Uso educativo · confirme a dose com seu médico</div>
</div>
<div class="mt-pose" data-layout-allow-overflow style="left:70px;top:540px;transform:scale(0.84)">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:calculator}}</div>
</div>
<div class="mt-syr" data-layout-allow-overflow>
  <div class="mt-rod mt-rodm"></div>
  <div class="mt-thumb"></div>
  <div class="mt-flange"></div>
  <div class="mt-barrel">
    <div class="mt-liquid"></div>
    <div class="mt-stopper"></div>
    <div class="mt-ticks"></div><div class="mt-ticks10"></div>
  </div>
  <div class="mt-mark" style="top:726px"></div>
  <div class="mt-hub"></div>
  <div class="mt-needle"></div>
</div>
<div class="mt-glass mt-ui">
  <div class="mt-gi mt-pos">{{icon:syringe}}</div>
  <div><div class="mt-gt" data-layout-allow-overlap><span class="mt-uibig">17</span> UI</div><div class="mt-gs" data-layout-allow-overlap>5 mg · 0,17 mL</div></div>
</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Da dose em miligramas para unidades na seringa .13–3.02 · Sempre confirmando com o seu médico 3.24–5.32
tl.fromTo(".mt-dust", { y: 20 }, { y: -60, duration: 5.47, ease: "none" }, 0);
tl.fromTo(".mt-rings", { rotation: 0 }, { rotation: 22, duration: 5.47, ease: "none" }, 0);
tl.fromTo(".mt-phone", { rotationY: 26, x: 60, rotationX: 4 }, { rotationY: 12, x: 0, rotationX: 3, duration: 1.4, ease: "power3.out" }, 0);
tl.to(".mt-phone", { rotationY: 8, duration: 4.07, ease: "sine.inOut" }, 1.4);
tl.fromTo(".mt-e", { opacity: 0, x: -36 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out" }, 0.05);
tl.fromTo(".mt-l1", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 0.1);
tl.fromTo(".mt-l2", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 1.4);
tl.fromTo(".mt-warn", { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.7, ease: "power2.out" }, 3.2);
[[".mt-calc-f1", 0.6], [".mt-calc-f2", 1.1], [".mt-calc-f3", 1.6]].forEach(([f, at]) => {
  tl.fromTo(f + " .mt-calc-field", { borderColor: "#DDE6F1", boxShadow: "0 0 0 0px #DCE9F9" }, { borderColor: "#1E5BB8", boxShadow: "0 0 0 3px #DCE9F9", duration: 0.2 }, at);
  tl.fromTo(f + " .mt-calc-field span", { opacity: 0, x: -10 }, { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" }, at + 0.12);
  tl.to(f + " .mt-calc-field", { borderColor: "#DDE6F1", boxShadow: "0 0 0 0px #DCE9F9", duration: 0.25 }, at + 0.45);
});
tl.fromTo(".mt-syr", { opacity: 0, x: 160 }, { opacity: 1, x: 0, duration: 1.1, ease: "expo.out" }, 0.7);
tl.fromTo(".mt-calc-res", { opacity: 0, scale: 0.9, y: 20 }, { opacity: 1, scale: 1, y: 0, duration: 0.6, ease: "back.out(1.8)" }, 2.15);
count(".mt-calc-ui", 0, 17, 0, 2.25, 1.3, "power2.inOut");
tl.fromTo(".mt-calc-sfill", { scaleX: 0 }, { scaleX: 1, duration: 1.3, ease: "power2.inOut" }, 2.25);
tl.fromTo(".mt-liquid", { scaleY: 0 }, { scaleY: 1, duration: 1.3, ease: "power2.inOut" }, 2.25);
tl.fromTo(".mt-stopper", { y: 108.8 }, { y: 0, duration: 1.3, ease: "power2.inOut" }, 2.25);
tl.fromTo([".mt-rodm", ".mt-thumb"], { y: 108 }, { y: 0, duration: 1.3, ease: "power2.inOut" }, 2.25);
tl.fromTo(".mt-mark", { opacity: 0, scaleX: 0 }, { opacity: 1, scaleX: 1, duration: 0.4, ease: "power2.out" }, 3.5);
tl.fromTo(".mt-ui", { opacity: 0, y: 60, scale: 0.6 }, { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: "back.out(1.6)" }, 2.85);
count(".mt-uibig", 0, 17, 0, 2.9, 0.9);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.2, ease: "power2.inOut" }, 3.9);
<!--NOTE-->
<b>Os três campos se preenchem em sequência, com o anel de foco descendo de um para o outro.</b> Ao mesmo tempo uma seringa grande entra vazia pela direita. Quando o resultado aparece, ela puxa até <b>17 UI</b>, junto com a contagem do app e a marca teal. A fórmula é a real do app: 5 mg ÷ 30 mg/mL × 100.
