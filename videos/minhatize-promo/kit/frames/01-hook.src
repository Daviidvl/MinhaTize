---
id: 01-hook
prefix: f01
duration: 7.35
title: Tudo espalhado
transition: corte seco (abertura)
---
<!--CSS-->
.mt-list { position:absolute; left:96px; top:250px; }
.mt-li { position:relative; display:flex; align-items:center; gap:26px; height:96px; font-size:58px; font-weight:300; letter-spacing:-0.03em; color:#F4F8FE; }
.mt-li .mt-lt { position:relative; }
.mt-li .mt-ln { font-size:22px; font-weight:700; color:#8FBDF0; letter-spacing:0.1em; width:44px; }
.mt-frag { position:absolute; }
.mt-note { left:100px; top:640px; width:470px; height:320px; border-radius:18px; padding:34px 36px;
  background:linear-gradient(180deg,#EEF4FC 0%,#DCE9F9 100%); color:#0B2545; box-shadow:0 40px 80px rgba(0,0,0,0.5);
  background-image:repeating-linear-gradient(180deg, rgba(30,91,184,0) 0 58px, rgba(30,91,184,0.18) 58px 60px), linear-gradient(180deg,#EEF4FC,#DCE9F9); }
.mt-note .mt-nh { font-size:22px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#51657F; display:flex; gap:10px; align-items:center; }
.mt-note .mt-nh svg { width:26px; height:26px; }
.mt-note .mt-nl { font-size:34px; font-weight:600; letter-spacing:-0.02em; margin-top:24px; line-height:60px; white-space:nowrap; }
.mt-note .mt-nl s { text-decoration-color:#3A86E0; text-decoration-thickness:3px; color:#51657F; }
.mt-shot { left:575px; top:760px; width:390px; height:300px; border-radius:22px; overflow:hidden;
  background:linear-gradient(160deg,#1E5BB8 0%,#0B2545 100%); border:6px solid #F4F8FE; box-shadow:0 40px 80px rgba(0,0,0,0.5); }
.mt-shot .mt-sb { position:absolute; left:26px; right:26px; height:22px; border-radius:11px; background:rgba(220,233,249,0.28); }
.mt-shot .mt-sl { position:absolute; left:24px; bottom:20px; display:flex; align-items:center; gap:10px; font-size:22px; font-weight:600; color:#DCE9F9; }
.mt-shot .mt-sl svg { width:28px; height:28px; }
.mt-alarm { left:170px; top:1120px; }
.mt-head { position:absolute; left:60px; right:60px; top:1300px; text-align:center; font-size:100px; font-weight:300; line-height:1.04; letter-spacing:-0.045em; color:#F4F8FE; }
.mt-head .mt-w { display:inline-block; }
<!--SKETCHCSS-->
.sk .mt-frag { opacity:0.42; filter:blur(2px); }
.sk .mt-li { opacity:0.55; }
.sk .mt-note { transform:rotate(-7deg); } .sk .mt-shot { transform:rotate(6deg); } .sk .mt-alarm { transform:rotate(-4deg); }
<!--HTML-->
{{stagebg}}
<div class="mt-streak" style="top:1250px"></div>
{{dust:46:11}}
<div class="mt-list">
  <div class="mt-li mt-li1"><span class="mt-ln">01</span><span class="mt-lt">Anotação no papel.<i class="mt-strike"></i></span></div>
  <div class="mt-li mt-li2"><span class="mt-ln">02</span><span class="mt-lt">Print no celular.<i class="mt-strike"></i></span></div>
  <div class="mt-li mt-li3"><span class="mt-ln">03</span><span class="mt-lt">Alarme esquecido.<i class="mt-strike"></i></span></div>
</div>
<div class="mt-frag mt-note">
  <div class="mt-nh">{{icon:note}}Lembrar</div>
  <div class="mt-nl"><s>Dose 2,5 mg</s> 5 mg?</div>
  <div class="mt-nl" style="margin-top:0">Aplicar qui… ou sex?</div>
</div>
<div class="mt-frag mt-shot">
  <div class="mt-sb" style="top:36px;width:62%"></div>
  <div class="mt-sb" style="top:76px;width:80%"></div>
  <div class="mt-sb" style="top:116px;width:48%"></div>
  <div class="mt-sb" style="top:156px;width:70%"></div>
  <div class="mt-sl">{{icon:image}}IMG_4821.png</div>
</div>
<div class="mt-frag mt-alarm mt-glass" style="position:absolute">
  <div class="mt-gi">{{icon:alarm}}</div>
  <div><div class="mt-gt" data-layout-allow-overlap>08:00 · Aplicação</div><div class="mt-gs" data-layout-allow-overlap>Adiado 3 vezes</div></div>
</div>
<div class="mt-head">
  <div><span class="mt-w mt-w1">Seu</span> <span class="mt-w mt-w2">tratamento</span></div>
  <div><span class="mt-w mt-w3">merece</span> <span class="mt-w mt-w4 mt-sheen">mais.</span></div>
</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Anotação .30 · Print 2.03 · Alarme 3.49 · Seu tratamento merece mais 5.16–7.16
tl.fromTo(".mt-bg", { opacity: 0.6 }, { opacity: 1, duration: 1.2, ease: "power2.out" }, 0);
tl.fromTo(".mt-glow", { scale: 0.85, opacity: 0.5 }, { scale: 1.05, opacity: 1, duration: 7.35, ease: "sine.inOut" }, 0);
tl.fromTo(".mt-dust", { y: 30 }, { y: -70, duration: 7.35, ease: "none" }, 0);
const beats = [
  [".mt-li1", ".mt-note", -7, 0.15],
  [".mt-li2", ".mt-shot", 6, 1.9],
  [".mt-li3", ".mt-alarm", -4, 3.35],
];
beats.forEach(([li, fr, rot, at]) => {
  tl.fromTo(li, { opacity: 0, x: -40, filter: "blur(10px)" }, { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.6, ease: "power3.out" }, at);
  tl.fromTo(fr, { opacity: 0, y: 120, scale: 0.86, rotation: rot * 2.2 }, { opacity: 1, y: 0, scale: 1, rotation: rot, duration: 0.8, ease: "back.out(1.4)" }, at + 0.05);
  tl.fromTo(fr, { x: 0 }, { x: rot * 3, duration: 4.4 - at * 0.5, ease: "sine.inOut", immediateRender: false }, at + 0.6);
});
tl.fromTo(".mt-strike", { scaleX: 0 }, { scaleX: 1, duration: 0.45, ease: "power2.inOut", stagger: 0.12 }, 4.25);
tl.to(".mt-li", { opacity: 0.32, duration: 0.6, ease: "power2.out" }, 4.6);
tl.to(".mt-frag", { opacity: 0.18, scale: 0.9, y: -60, filter: "blur(6px)", duration: 1.0, ease: "power3.inOut", stagger: 0.06 }, 4.45);
tl.fromTo(".mt-w", { opacity: 0, y: 50, filter: "blur(14px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out", stagger: 0.4 }, 5.0);
tl.fromTo(".mt-w4", { scale: 0.9 }, { scale: 1, duration: 0.9, ease: "back.out(2)", immediateRender: false }, 6.25);
tl.fromTo(".mt-streak", { opacity: 0, scaleX: 0.2 }, { opacity: 1, scaleX: 1, duration: 0.9, ease: "power2.out" }, 6.3);
<!--NOTE-->
<b>Três linhas entram uma a uma, cada uma com seu fragmento</b> (bilhete, print, alarme), que cai girando com mola. Depois as linhas são riscadas, os fragmentos recuam desfocados e <i>"Seu tratamento merece mais."</i> sobe palavra por palavra, com um feixe de luz por baixo.
