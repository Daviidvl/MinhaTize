---
id: 04-calendario
prefix: f04
duration: 5.36
title: Nunca perca uma aplicação
transition: push-slide LEFT
---
<!--CSS-->
.mt-copy { position:absolute; left:96px; right:96px; top:200px; }
.mt-copy .mt-eyebrow { margin-bottom:22px; }
.mt-copy .mt-h .mt-line { display:block; }
.mt-c1 { left:50px; top:1060px; }
.mt-c2 { left:520px; top:1330px; }
.mt-tap { position:absolute; width:90px; height:90px; border-radius:50%; border:3px solid #8FBDF0; left:649px; top:1163px; }
<!--SKETCHCSS-->
.sk .mt-phone { transform:rotateY(10deg) rotateX(3deg); }
.sk .mt-tap { opacity:0; }
<!--HTML-->
{{stagebg}}
<div class="mt-rings" style="top:1050px"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div></div>
{{dust:40:44}}
<div class="mt-copy">
  <div class="mt-eyebrow mt-e">Calendário</div>
  <div class="mt-h"><span class="mt-line mt-l1">Nunca perca</span><span class="mt-line mt-l2"><b>uma aplicação.</b></span></div>
</div>
<div class="mt-pose" data-layout-allow-overflow style="left:230px;top:500px;transform:scale(0.88)">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:calendar}}</div>
</div>
<div class="mt-tap"></div>
<div class="mt-glass mt-c1">
  <div class="mt-gi">{{icon:bell}}</div>
  <div><div class="mt-gt" data-layout-allow-overlap>Próxima em 7 dias</div><div class="mt-gs" data-layout-allow-overlap>quinta, 22 de outubro</div></div>
</div>
<div class="mt-glass mt-c2">
  <div class="mt-gi mt-pos">{{icon:check}}</div>
  <div><div class="mt-gt" data-layout-allow-overlap>Aderência <span class="mt-adhbig">100</span>%</div><div class="mt-gs" data-layout-allow-overlap>12 semanas seguidas</div></div>
</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Nunca perca uma aplicação .14–1.84 · Registre com um toque 2.17–4.12 · e saiba quando é a próxima 4.24–5.23
tl.fromTo(".mt-dust", { y: 20 }, { y: -60, duration: 5.36, ease: "none" }, 0);
tl.fromTo(".mt-rings", { rotation: -10 }, { rotation: 18, duration: 5.36, ease: "none" }, 0);
tl.fromTo(".mt-phone", { rotationY: 24, rotationX: 4 }, { rotationY: 10, rotationX: 3, duration: 1.4, ease: "power3.out" }, 0);
tl.to(".mt-phone", { rotationY: 6, rotationX: 2, duration: 3.96, ease: "sine.inOut" }, 1.4);
tl.fromTo(".mt-e", { opacity: 0, x: -36 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out" }, 0.1);
tl.fromTo(".mt-l1", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 0.15);
tl.fromTo(".mt-l2", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 0.85);
tl.fromTo(".mt-day", { opacity: 0, scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.45, ease: "back.out(2)", stagger: { each: 0.025, from: "start" } }, 0.45);
tl.fromTo([".mt-day-1 .mt-dm", ".mt-day-8 .mt-dm"], { scale: 0 }, { scale: 1, duration: 0.5, ease: "back.out(2.5)", stagger: 0.15 }, 1.4);
tl.fromTo([".mt-day-22 .mt-dm", ".mt-day-29 .mt-dm"], { scale: 0, rotation: -90 }, { scale: 1, rotation: 0, duration: 0.6, ease: "power3.out", stagger: 0.12 }, 1.65);
tl.fromTo([".mt-cal-s1", ".mt-cal-s2", ".mt-cal-s3", ".mt-cal-today"], { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", stagger: 0.08 }, 1.1);
tl.fromTo(".mt-day-15 .mt-dm", { backgroundColor: "#1E5BB8", scale: 1 }, { backgroundColor: "#1E5BB8", scale: 1.12, duration: 0.3, ease: "sine.inOut" }, 2.4);
tl.fromTo(".mt-tap", { opacity: 0, scale: 1.6 }, { opacity: 1, scale: 0.8, duration: 0.35, ease: "power2.out" }, 3.2);
tl.to(".mt-tap", { opacity: 0, scale: 1.4, duration: 0.4, ease: "power2.out" }, 3.58);
tl.fromTo(".mt-cal-btn", { scale: 1, opacity: 1 }, { scale: 0.92, duration: 0.15, ease: "power2.in" }, 3.3);
tl.to(".mt-cal-btn", { opacity: 0, duration: 0.2 }, 3.45);
tl.fromTo(".mt-cal-done", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.45, ease: "back.out(2.4)" }, 3.45);
tl.to(".mt-day-15 .mt-dm", { backgroundColor: "#19B5A5", scale: 1, duration: 0.5, ease: "back.out(2)" }, 3.5);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.2, ease: "power2.inOut" }, 3.6);
tl.fromTo(".mt-c1", { opacity: 0, x: 220, scale: 0.55 }, { opacity: 1, x: 0, scale: 1, duration: 0.85, ease: "back.out(1.5)" }, 4.15);
tl.fromTo(".mt-c2", { opacity: 0, x: -220, scale: 0.55 }, { opacity: 1, x: 0, scale: 1, duration: 0.85, ease: "back.out(1.5)" }, 4.5);
count(".mt-adhbig", 0, 100, 0, 4.55, 0.8);
<!--NOTE-->
<b>O celular gira para o lado oposto ao da cena 3 e o mês entra em cascata, dia a dia.</b> As aplicações passadas acendem em teal. Um toque em "Registrar" vira "Registrado ✓" e o dia 15 enche. Depois saltam os chips "Próxima em 7 dias" e "Aderência 100%".
