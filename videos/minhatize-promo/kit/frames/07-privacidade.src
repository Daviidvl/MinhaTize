---
id: 07-privacidade
prefix: f07
duration: 4.79
title: Seu, e só seu
transition: blur-crossfade
---
<!--CSS-->
.mt-rows { position:absolute; left:96px; right:60px; top:210px; }
.mt-row { display:flex; align-items:center; gap:28px; margin-bottom:26px; }
.mt-row .mt-ri { width:84px; height:84px; border-radius:26px; background:rgba(220,233,249,0.10); border:1.5px solid rgba(143,189,240,0.30); color:#8FBDF0; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.mt-row .mt-ri svg { width:42px; height:42px; }
.mt-row .mt-rt { font-size:64px; font-weight:300; letter-spacing:-0.035em; line-height:1.06; color:#F4F8FE; }
.mt-row.mt-big .mt-ri { background:#D7F3EF; color:#0B6F6A; border-color:#19B5A5; }
.mt-halo { position:absolute; left:0; top:0; width:0; height:0; }
.mt-halo i { position:absolute; border-radius:50%; border:3px solid #8FBDF0; }
<!--SKETCHCSS-->
.sk .mt-halo { opacity:0; }
.sk .mt-phone { transform:rotateX(4deg); }
<!--HTML-->
{{stagebg}}
<div class="mt-rings" style="top:1180px"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div></div>
{{dust:40:77}}
<div class="mt-rows">
  <div class="mt-row mt-r1x"><div class="mt-ri">{{icon:userx}}</div><div class="mt-rt">Sem cadastro.</div></div>
  <div class="mt-row mt-r2x"><div class="mt-ri">{{icon:key}}</div><div class="mt-rt">Sem senha.</div></div>
  <div class="mt-row mt-r3x mt-big"><div class="mt-ri">{{icon:shield}}</div><div class="mt-rt"><span style="display:block">Seus dados ficam</span><span class="mt-sheen" style="display:block">no seu celular.</span></div></div>
</div>
<div class="mt-pose" data-layout-allow-overflow style="left:230px;top:700px;transform:scale(0.8)">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:home:dark}}</div>
</div>
<div class="mt-halo" data-layout-allow-overflow style="left:491px;top:1091px"><i class="mt-h1" style="left:-80px;top:-80px;width:160px;height:160px"></i><i class="mt-h2" style="left:-80px;top:-80px;width:160px;height:160px;border-color:#2BD4C0"></i></div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Sem cadastro .11 · Sem senha 1.29 · Seus dados ficam no seu celular 2.47–4.61
tl.fromTo(".mt-dust", { y: 20 }, { y: -60, duration: 4.79, ease: "none" }, 0);
tl.fromTo(".mt-rings", { rotation: 0 }, { rotation: 22, duration: 4.79, ease: "none" }, 0);
tl.fromTo(".mt-phone", { y: 160, rotationX: 14 }, { y: 0, rotationX: 4, duration: 1.4, ease: "power3.out" }, 0);
tl.fromTo(".mt-home-app:not(.mt-home-mt)", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)", stagger: 0.03 }, 0.2);
tl.fromTo(".mt-r1x", { opacity: 0, x: -50, filter: "blur(10px)" }, { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 0.05);
tl.fromTo(".mt-r2x", { opacity: 0, x: -50, filter: "blur(10px)" }, { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 1.22);
tl.fromTo(".mt-r3x", { opacity: 0, x: -50, filter: "blur(10px)" }, { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.8, ease: "power3.out" }, 2.4);
tl.fromTo(".mt-r3x .mt-ri", { scale: 0.5, rotation: -20 }, { scale: 1, rotation: 0, duration: 0.8, ease: "back.out(2.5)" }, 2.5);
tl.fromTo(".mt-home-mt", { y: -150, scale: 2.2, opacity: 0 }, { y: 0, scale: 1, opacity: 1, duration: 0.85, ease: "back.out(1.6)" }, 3.1);
tl.fromTo(".mt-h1", { scale: 0.5, opacity: 0.9 }, { scale: 2.6, opacity: 0, duration: 1.0, ease: "power2.out" }, 3.75);
tl.fromTo(".mt-h2", { scale: 0.5, opacity: 0.8 }, { scale: 3.6, opacity: 0, duration: 1.2, ease: "power2.out" }, 3.9);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.1, ease: "power2.inOut" }, 3.6);
<!--NOTE-->
<b>Três promessas curtas entram uma por beat, cada uma com seu ícone.</b> A última ganha o selo teal de escudo. No celular, os apps da tela inicial surgem e o ícone da MinhaTize cai no lugar dele com um halo de luz: é o momento de "instalar como app".
