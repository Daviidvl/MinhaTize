---
id: 08-cta
prefix: f08
duration: 5.74
title: Garanta seu acesso
transition: zoom-through
---
<!--CSS-->
.mt-rings { left:540px; top:400px; }
.mt-logo-wrap { position:absolute; left:455px; top:315px; width:170px; height:170px; }
.mt-word { position:absolute; left:0; right:0; top:530px; text-align:center; font-size:120px; font-weight:300; letter-spacing:-0.05em; line-height:1; color:#F4F8FE; }
.mt-word b { font-weight:800; }
.mt-tag { position:absolute; left:80px; right:80px; top:680px; text-align:center; font-size:38px; font-weight:400; letter-spacing:-0.01em; color:rgba(220,233,249,0.72); }
.mt-cta { left:230px; width:620px; top:775px; }
.mt-bio { position:absolute; left:0; right:0; top:918px; text-align:center; }
.mt-legal { position:absolute; left:0; right:0; top:1000px; text-align:center; font-size:20px; }
<!--SKETCHCSS-->
.sk .mt-phone { transform:rotateX(10deg); }
<!--HTML-->
{{stagebg}}
<div class="mt-rings"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div><div class="mt-ring-dot" style="left:-7px;top:-387px"></div></div>
{{dust:50:88}}
<div class="mt-floor" style="top:1820px"></div>
<div class="mt-pose" data-layout-allow-overflow style="left:230px;top:1080px;transform:scale(0.84)">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:dashboard}}</div>
</div>
<div class="mt-logo-wrap">{{logo:170}}</div>
<div class="mt-word">Minha<b class="mt-sheen">Tize</b></div>
<div class="mt-tag">Todo o seu tratamento num só lugar.</div>
<div class="mt-cta"><span class="mt-ctat">Garanta seu acesso</span>{{icon:sparkle}}<i class="mt-shine"></i></div>
<div class="mt-bio mt-eyebrow">link na bio</div>
<div class="mt-legal mt-fine">Plataforma educativa. Não substitui orientação médica.</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: MinhaTize .18–.97 · Garanta seu acesso 1.22–2.53 · Link na bio 2.79–3.59 · hold
tl.fromTo(".mt-dust", { y: 30 }, { y: -70, duration: 5.74, ease: "none" }, 0);
tl.fromTo(".mt-glow", { scale: 0.9 }, { scale: 1.08, duration: 5.74, ease: "sine.inOut" }, 0);
tl.fromTo(".mt-rings", { rotation: -30 }, { rotation: 10, duration: 5.74, ease: "none" }, 0);
tl.fromTo(".mt-ring", { scale: 0.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.4, ease: "expo.out", stagger: 0.1 }, 0.05);
tl.fromTo(".mt-phone", { y: 600, rotationX: 30, opacity: 0 }, { y: 0, rotationX: 10, opacity: 1, duration: 1.6, ease: "expo.out" }, 0.05);
tl.fromTo(".mt-floor", { opacity: 0, scaleX: 0.4 }, { opacity: 1, scaleX: 1, duration: 1.4, ease: "power2.out" }, 0.3);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.4, ease: "power2.inOut" }, 1.3);
tl.fromTo(".mt-logo-wrap", { scale: 0.3, opacity: 0, filter: "blur(20px)" }, { scale: 1, opacity: 1, filter: "blur(0px)", duration: 1.0, ease: "expo.out" }, 0.05);
tl.fromTo(".mt-word", { opacity: 0, y: 50, scale: 1.06, filter: "blur(10px)" }, { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.9, ease: "power3.out" }, 0.18);
tl.fromTo(".mt-tag", { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0.75);
tl.fromTo(".mt-cta", { clipPath: "inset(0 290px 0 290px round 999px)", opacity: 0 }, { clipPath: "inset(0 0px 0 0px round 999px)", opacity: 1, duration: 0.85, ease: "expo.out" }, 1.1);
tl.fromTo(".mt-cta", { scale: 0.92 }, { scale: 1, duration: 1.0, ease: "back.out(2)", immediateRender: false }, 1.15);
tl.fromTo([".mt-ctat", ".mt-cta svg"], { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", stagger: 0.08 }, 1.25);
tl.fromTo(".mt-shine", { x: 0 }, { x: 900, duration: 0.9, ease: "power2.inOut" }, 2.1);
tl.fromTo(".mt-shine", { x: 0 }, { x: 900, duration: 0.9, ease: "power2.inOut", immediateRender: false }, 4.1);
tl.fromTo(".mt-bio", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, 2.75);
tl.fromTo(".mt-legal", { opacity: 0 }, { opacity: 1, duration: 0.8 }, 3.4);
<!--NOTE-->
<b>Os anéis se abrem enquanto o celular sobe e se inclina para trás, como um produto numa vitrine.</b> O logo floresce, depois vêm "MinhaTize" e a promessa. A pílula do CTA cresce a partir de um ponto, um brilho passa por ela duas vezes, e "link na bio" e o aviso educativo assentam por último.
