---
id: 02-intro
prefix: f02
duration: 4.61
title: MinhaTize
transition: zoom-through
---
<!--CSS-->
.mt-rings { left:540px; top:540px; }
.mt-spark { position:absolute; left:540px; top:540px; width:0; height:0; }
.mt-spark i { position:absolute; left:-90px; top:-90px; width:180px; height:180px; border-radius:50%;
  background:radial-gradient(closest-side, rgba(255,255,255,0.95), rgba(143,189,240,0.55) 35%, rgba(30,91,184,0) 100%); }
.mt-logo-wrap { position:absolute; left:440px; top:440px; width:200px; height:200px; }
.mt-word { position:absolute; left:0; right:0; top:690px; text-align:center; font-size:128px; font-weight:300; letter-spacing:-0.05em; color:#F4F8FE; line-height:1; }
.mt-word .mt-ch { display:inline-block; }
.mt-word .mt-b { font-weight:800; }
.mt-tag { position:absolute; left:80px; right:80px; top:860px; text-align:center; font-size:60px; font-weight:300; letter-spacing:-0.035em; line-height:1.12; color:rgba(244,248,254,0.92); }
.mt-tag .mt-tl { display:block; }
.mt-blackout { position:absolute; inset:0; background:#050B18; z-index:8; border-radius:104px; }
<!--SKETCHCSS-->
.sk .mt-blackout { opacity:0; }
<!--HTML-->
{{stagebg}}
<div class="mt-rings"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div><div class="mt-ring-dot" style="left:373px;top:-7px"></div></div>
{{dust:40:22}}
<div class="mt-floor" style="top:1700px"></div>
<div class="mt-spark"><i></i></div>
<div class="mt-logo-wrap">{{logo:200}}</div>
<div class="mt-word"><span class="mt-ch">M</span><span class="mt-ch">i</span><span class="mt-ch">n</span><span class="mt-ch">h</span><span class="mt-ch">a</span><span class="mt-ch mt-b mt-sheen">T</span><span class="mt-ch mt-b mt-sheen">i</span><span class="mt-ch mt-b mt-sheen">z</span><span class="mt-ch mt-b mt-sheen">e</span></div>
<div class="mt-tag"><span class="mt-tl mt-tl1">Todo o seu tratamento</span><span class="mt-tl mt-tl2"><span class="mt-sheen">num só lugar.</span></span></div>
<div class="mt-pose" data-layout-allow-overflow style="left:230px;top:1090px">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:dashboard}}<div class="mt-blackout" style="left:24px;top:24px;width:572px;height:1242px;inset:auto"></div></div>
</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Esta é a MinhaTize .20–1.80 · Todo o seu tratamento, num só lugar 2.19–4.44
tl.fromTo(".mt-glow", { scale: 0.7, opacity: 0.3 }, { scale: 1, opacity: 1, duration: 2.0, ease: "power2.out" }, 0);
tl.fromTo(".mt-dust", { y: 40 }, { y: -60, duration: 4.61, ease: "none" }, 0);
tl.fromTo(".mt-spark i", { scale: 0, opacity: 0 }, { scale: 1.4, opacity: 1, duration: 0.45, ease: "power3.out" }, 0.0);
tl.to(".mt-spark i", { scale: 3.2, opacity: 0, duration: 0.8, ease: "power2.out" }, 0.45);
tl.fromTo(".mt-ring", { scale: 0.35, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.3, ease: "expo.out", stagger: 0.1 }, 0.15);
tl.fromTo(".mt-rings", { rotation: -25 }, { rotation: 15, duration: 4.61, ease: "none" }, 0);
tl.fromTo(".mt-logo-wrap", { scale: 0.3, opacity: 0, filter: "blur(24px)" }, { scale: 1, opacity: 1, filter: "blur(0px)", duration: 1.0, ease: "expo.out" }, 0.3);
tl.fromTo(".mt-ch", { opacity: 0, y: 70, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.65, ease: "power3.out", stagger: 0.05 }, 0.85);
tl.fromTo(".mt-tl1", { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 2.1);
tl.fromTo(".mt-tl2", { opacity: 0, y: 36, filter: "blur(8px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, ease: "power3.out" }, 3.2);
tl.fromTo(".mt-phone", { y: 820, rotationX: 28, opacity: 0 }, { y: 0, rotationX: 0, opacity: 1, duration: 1.6, ease: "expo.out" }, 2.2);
tl.fromTo(".mt-pshadow", { opacity: 0 }, { opacity: 1, duration: 1.2 }, 2.7);
tl.fromTo(".mt-blackout", { opacity: 1 }, { opacity: 0, duration: 0.7, ease: "power2.out" }, 3.3);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.0, ease: "power2.inOut" }, 3.6);
tl.fromTo(".mt-floor", { opacity: 0, scaleX: 0.5 }, { opacity: 1, scaleX: 1, duration: 1.4, ease: "power2.out" }, 2.5);
count(".mt-dash-kg", 90, 90, 1, 0, 0.01);
count(".mt-dash-lostn", 0, 0, 1, 0, 0.01);
count(".mt-dash-pct", 0, 0, 0, 0, 0.01);
tl.set(".mt-dash-ring", { attr: { "stroke-dashoffset": 276.46 } }, 0);
tl.set(".mt-dash-bar", { scaleX: 0 }, 0);
tl.set(".mt-dash-lost", { opacity: 0 }, 0);
<!--NOTE-->
<b>Um ponto de luz se abre em anéis e o logo floresce dele.</b> As letras de "MinhaTize" caem em cascata e a frase-promessa sobe em duas linhas. Por fim o celular sobe do escuro, inclinado para trás, até endireitar, e a tela acende na Início.
