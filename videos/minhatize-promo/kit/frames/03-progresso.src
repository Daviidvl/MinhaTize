---
id: 03-progresso
prefix: f03
duration: 5.0
title: Sua evolução
transition: crossfade
---
<!--CSS-->
.mt-copy { position:absolute; left:96px; right:96px; top:200px; }
.mt-copy .mt-eyebrow { margin-bottom:22px; }
.mt-copy .mt-h .mt-line { display:block; }
.mt-c1 { left:600px; top:470px; }
.mt-c2 { left:56px; top:1010px; }
.mt-ringico { width:76px; height:76px; border-radius:24px; background:#DCE9F9; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.mt-imc { left:640px; top:1240px; width:330px; }
<!--SKETCHCSS-->
.sk .mt-phone { transform:rotateY(-10deg) rotateX(3deg); }
<!--HTML-->
{{stagebg}}
<div class="mt-rings" style="top:1050px"><div class="mt-ring mt-r1"></div><div class="mt-ring mt-r2"></div><div class="mt-ring mt-r3"></div></div>
{{dust:40:33}}
<div class="mt-copy">
  <div class="mt-eyebrow mt-e">Progresso</div>
  <div class="mt-h"><span class="mt-line mt-l1">Veja sua evolução</span><span class="mt-line mt-l2"><b>quilo a quilo.</b></span></div>
</div>
<div class="mt-pose" data-layout-allow-overflow style="left:230px;top:500px;transform:scale(0.88)">
  <div class="mt-pshadow"></div>
  <div class="mt-phone">{{phone:dashboard}}</div>
</div>
<div class="mt-glass mt-c1">
  <div class="mt-gi mt-pos">{{icon:trend}}</div>
  <div><div class="mt-gt" data-layout-allow-overlap><span class="mt-lostbig">7,6</span> kg</div><div class="mt-gs" data-layout-allow-overlap>eliminados</div></div>
</div>
<div class="mt-glass mt-c2">
  <div class="mt-ringico"><svg width="44" height="44" viewBox="0 0 44 44"><circle cx="22" cy="22" r="17" fill="none" stroke="#8FBDF0" stroke-opacity=".45" stroke-width="5"/><circle class="mt-miniring" cx="22" cy="22" r="17" fill="none" stroke="#19B5A5" stroke-width="5" stroke-linecap="round" stroke-dasharray="106.8" stroke-dashoffset="49.1" transform="rotate(-90 22 22)"/></svg></div>
  <div><div class="mt-gt" data-layout-allow-overlap>54% da meta</div><div class="mt-gs" data-layout-allow-overlap>faltam 6,4 kg</div></div>
</div>
<div class="mt-fcard mt-imc">
  <div class="mt-fi">{{icon:activity}}</div>
  <div class="mt-fl" data-layout-allow-overlap>IMC</div>
  <div class="mt-fv" data-layout-allow-overlap>28,5</div>
  <div class="mt-fs" data-layout-allow-overlap>↓ 2,6 desde o início</div>
</div>
<div class="mt-grain"></div><div class="mt-vignette"></div>
<!--JS-->
// voice: Veja sua evolução .17 · quilo a quilo 1.56 · Cada conquista, registrada 2.96–4.86
tl.fromTo(".mt-dust", { y: 20 }, { y: -60, duration: 5, ease: "none" }, 0);
tl.fromTo(".mt-rings", { rotation: 10 }, { rotation: 36, duration: 5, ease: "none" }, 0);
tl.fromTo(".mt-phone", { y: 670, scale: 1.136, rotationY: 0, rotationX: 0 }, { y: 0, scale: 1, rotationY: -14, rotationX: 4, duration: 1.3, ease: "power3.inOut" }, 0);
tl.to(".mt-phone", { rotationY: -7, rotationX: 2, duration: 3.7, ease: "sine.inOut" }, 1.3);
tl.fromTo(".mt-glare", { x: 0 }, { x: 1150, duration: 1.4, ease: "power2.inOut" }, 1.0);
tl.fromTo(".mt-e", { opacity: 0, x: -36 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out" }, 0.15);
tl.fromTo(".mt-l1", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 0.2);
tl.fromTo(".mt-l2", { opacity: 0, y: 40, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.7, ease: "power3.out" }, 1.5);
count(".mt-dash-kg", 90, 82.4, 1, 1.2, 1.7, "power2.out");
count(".mt-dash-lostn", 0, 7.6, 1, 1.2, 1.7, "power2.out");
count(".mt-dash-pct", 0, 54, 0, 1.2, 1.7, "power2.out");
tl.fromTo(".mt-dash-ring", { attr: { "stroke-dashoffset": 276.46 } }, { attr: { "stroke-dashoffset": 127.17 }, duration: 1.7, ease: "power2.out" }, 1.2);
tl.fromTo(".mt-dash-bar", { scaleX: 0 }, { scaleX: 1, duration: 1.7, ease: "power2.out" }, 1.2);
tl.fromTo(".mt-dash-lost", { scale: 0.7, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(2.2)" }, 1.5);
tl.fromTo(".mt-c1", { opacity: 0, x: -260, y: 90, scale: 0.5 }, { opacity: 1, x: 0, y: 0, scale: 1, duration: 0.9, ease: "back.out(1.5)" }, 2.9);
count(".mt-lostbig", 0, 7.6, 1, 2.95, 1.0);
tl.fromTo(".mt-c2", { opacity: 0, x: 240, y: 40, scale: 0.5 }, { opacity: 1, x: 0, y: 0, scale: 1, duration: 0.9, ease: "back.out(1.5)" }, 3.45);
tl.fromTo(".mt-miniring", { attr: { "stroke-dashoffset": 106.8 } }, { attr: { "stroke-dashoffset": 49.1 }, duration: 1.0, ease: "power2.out" }, 3.55);
tl.fromTo(".mt-imc", { opacity: 0, y: 120, rotation: 6, scale: 0.85 }, { opacity: 1, y: 0, rotation: 0, scale: 1, duration: 0.95, ease: "expo.out" }, 3.95);
tl.fromTo([".mt-c1", ".mt-c2"], { yPercent: 0 }, { yPercent: -8, duration: 1.4, ease: "sine.inOut", stagger: 0.3, immediateRender: false }, 3.8);
<!--NOTE-->
<b>O celular sai da pose da cena 2 e sobe para uma pose 3/4.</b> Dentro do app, o peso desce de 90,0 para 82,4 kg, o anel enche até 54% e a barra acompanha. Em seguida "7,6 kg eliminados" e "54% da meta" saltam para fora da tela, e o cartão do IMC chega por último.
